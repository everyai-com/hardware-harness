# Copy to .env and fill in your own values.
# Token: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: actor override (defaults to BELjuwQScEd6DZpW3 - Twitter (X) Comment Scraper)
# APIFY_ACTOR=BELjuwQScEd6DZpW3

# Optional: overrides applied on top of apify-input.json
# TWEET_URL=https://x.com/user/status/1234567890123456789
# X_COOKIES=auth_token=xxx; ct0=yyy; twid=zzz
